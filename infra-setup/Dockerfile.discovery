FROM python:3.12-slim

# nmap precisa de root para raw sockets — rodamos com NET_RAW capability
RUN apt-get update -qq && \
    apt-get install -y --no-install-recommends nmap iputils-ping && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt && \
    pip install --no-cache-dir python-nmap zabbix-utils influxdb-client

COPY collectors/network_discovery.py ./collectors/
COPY . .

# nmap precisa de NET_RAW; não precisa de root completo
USER root

ENTRYPOINT ["python3", "collectors/network_discovery.py"]
