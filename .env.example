# ═══════════════════════════════════════════════════════════════
# 🔧 IT GOVERNANCE DASHBOARD — CONFIGURAÇÃO DE AMBIENTE
# ═══════════════════════════════════════════════════════════════
# Copie este arquivo para .env e preencha com seus valores reais
# NUNCA commite o .env com valores reais!
#
# Uso: cp .env.example .env && nano .env
# ═══════════════════════════════════════════════════════════════

# ───────────────────────────────────────────────────────────────
# 🌐 FLASK APPLICATION
# ───────────────────────────────────────────────────────────────
FLASK_PORT=5000
FLASK_DEBUG=False
CACHE_TTL=60

# ───────────────────────────────────────────────────────────────
# 📊 INFLUXDB (métricas e séries temporais)
# ───────────────────────────────────────────────────────────────
INFLUX_URL=http://localhost:8086
INFLUX_ORG=your-org-name
INFLUX_BUCKET=your-bucket-name
INFLUX_TOKEN=your-influxdb-token-here

# ───────────────────────────────────────────────────────────────
# 🔔 ZABBIX (monitoramento de infraestrutura)
# ───────────────────────────────────────────────────────────────
ZABBIX_URL=https://zabbix.example.com/api_jsonrpc.php
ZABBIX_FRONT_URL=https://zabbix.example.com
ZABBIX_TOKEN=your-zabbix-api-token
ZABBIX_USER=api_user
ZABBIX_PASSWORD=change-me

# ───────────────────────────────────────────────────────────────
# ☁️  AZURE / MICROSOFT 365
# ───────────────────────────────────────────────────────────────
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_SECRET=your-azure-client-secret

# ───────────────────────────────────────────────────────────────
# 📈 GRAFANA (dashboards externos)
# ───────────────────────────────────────────────────────────────
GRAFANA_URL=https://grafana.example.com
GRAFANA_TOKEN=your-grafana-service-account-token
GRAFANA_TOKEN_OLD=deprecated-keep-for-rollback

# ───────────────────────────────────────────────────────────────
# 🔐 LDAP / ACTIVE DIRECTORY
# ───────────────────────────────────────────────────────────────
LDAP_ENABLED=True
LDAP_SERVER=ldap://dc.example.local
LDAP_USER=CN=svc_dashboard,OU=Services,DC=example,DC=local
LDAP_PASSWORD=change-me
LDAP_BASE_DN=DC=example,DC=local

# ───────────────────────────────────────────────────────────────
# 💰 PINs DE ACESSO (áreas restritas)
# ───────────────────────────────────────────────────────────────
FINOPS_PIN=0000
OPS_PIN=0000

# ───────────────────────────────────────────────────────────────
# 📨 NOTIFICAÇÕES — TELEGRAM
# ───────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your-bot-token-from-botfather
TELEGRAM_CHAT_ID=-1001234567890

# ───────────────────────────────────────────────────────────────
# 📨 NOTIFICAÇÕES — MICROSOFT TEAMS
# ───────────────────────────────────────────────────────────────
TEAMS_WEBHOOK_URL=https://outlook.office.com/webhook/your-webhook-url

# ───────────────────────────────────────────────────────────────
# 📧 SMTP (envio de e-mails)
# ───────────────────────────────────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_AUTH=True
SMTP_TLS=True
SMTP_FROM=noreply@example.com
SMTP_TO=ops@example.com
