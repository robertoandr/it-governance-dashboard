# ============================================================
# IT Governance Dashboard — Environment Variables Template
# Copie para .env e preencha os valores reais (nunca commite .env)
# ============================================================

# --- App ---
APP_NAME="IT Governance Dashboard"
APP_VERSION="0.1.0"
DEBUG=false
SECRET_KEY="change-me-to-a-random-string-of-at-least-32-characters"

# --- InfluxDB v2 ---
INFLUX_URL="http://localhost:8086"
INFLUX_TOKEN="your-influxdb-token-here"
INFLUX_ORG="your-org"
INFLUX_BUCKET="it-governance"

# --- GitHub ---
GITHUB_TOKEN="ghp_your_token_here"
GITHUB_ORG="your-github-org"

# --- Zabbix JSON-RPC ---
ZABBIX_URL="http://zabbix.internal/api_jsonrpc.php"
ZABBIX_USER="api-user"
ZABBIX_PASSWORD="api-password"

# --- Zendesk ---
ZENDESK_SUBDOMAIN="yourcompany"
ZENDESK_EMAIL="api@yourcompany.com"
ZENDESK_TOKEN="your-zendesk-api-token"

# --- Microsoft Entra ID (OAuth2 / MS Graph) ---
AZURE_TENANT_ID="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
AZURE_CLIENT_ID="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
AZURE_CLIENT_SECRET="your-client-secret"
