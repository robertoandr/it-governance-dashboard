# ============================================
# IT Gov Dashboard — Template de Variáveis
# Copie para .env e preencha os valores reais
# NUNCA commite o .env real!
# ============================================

# ===== App (Pydantic Settings nested via __) =====
APP__NAME="IT Governance Dashboard"
APP__VERSION=1.1.0
APP__ENVIRONMENT=development
APP__SECRET_KEY=change-me-use-secrets-token-hex-32
APP__DEBUG=false
APP__TESTING=false
APP__HOST=0.0.0.0
APP__PORT=5000

# ===== Database =====
DB__URL=sqlite:///data/govti.db
DB__DATA_DIR=data

# ===== InfluxDB =====
INFLUX__URL=http://localhost:8086
INFLUX__TOKEN=
INFLUX__ORG=gadens
INFLUX__BUCKET=govti
INFLUX__ENABLED=false

# ===== Zabbix =====
ZABBIX__URL=http://localhost/zabbix/api_jsonrpc.php
ZABBIX__USER=Admin
ZABBIX__PASSWORD=
ZABBIX__ENABLED=false

# ===== GitHub =====
GITHUB__TOKEN=
GITHUB__ORG=
GITHUB__ENABLED=false

# ===== Zendesk =====
ZENDESK__URL=
ZENDESK__EMAIL=
ZENDESK__TOKEN=
ZENDESK__ENABLED=false

# ===== Microsoft Graph / Azure AD — app/config.py (Pydantic, migração futura) =====
# Nota: em produção o config.py raiz lê as vars AZURE_* (seção abaixo).
GRAPH__TENANT_ID=
GRAPH__CLIENT_ID=
GRAPH__CLIENT_SECRET=
GRAPH__ENABLED=false

# ===== Logging =====
LOGGING__LEVEL=INFO
LOGGING__FORMAT=console

# ===== Score Thresholds =====
SCORE__THRESHOLD_OPERATIONAL=85.0
SCORE__THRESHOLD_DEGRADED=60.0
SCORE__CACHE_TTL_SECONDS=25


# ===== Flask =====
FLASK_ENV=production
FLASK_DEBUG=0
SECRET_KEY=change-me-use-secrets-token-hex-32

# ===== Zendesk =====
ZENDESK_SUBDOMAIN=sua-empresa
ZENDESK_EMAIL=api-user@sua-empresa.com
ZENDESK_API_TOKEN=
# Pagination safeguard: max pages per call (100 pages x 100 tickets = 10k records)
ZENDESK_MAX_PAGES=100

# ===== Manutencao (OPS_PIN) =====
# Vazio = endpoints de escrita bloqueados por design. Defina para habilitar.
OPS_PIN=

# ===== Zabbix =====
ZABBIX_URL=https://zabbix.exemplo.com/api_jsonrpc.php
ZABBIX_USER=api_user
ZABBIX_PASSWORD=
ZABBIX_TOKEN=

# ===== InfluxDB 2.x =====
INFLUX_URL=http://localhost:8086
INFLUX_TOKEN=
INFLUX_ORG=gadens
INFLUX_BUCKET=governance

# ===== Microsoft Graph / Azure AD — produção (config.py raiz) =====
# Registre um App Registration no Azure AD e preencha os três campos abaixo.
# Migration: se você tinha MSAL_* ou GRAPH_CLIENT_SECRET, renomeie para AZURE_*.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
# Habilita coleta de dados do Intune (requer escopo DeviceManagementManagedDevices.Read.All)
INTUNE_ENABLED=true

# ===== Acronis Cyber Cloud — collector/config.py =====
# Obtenha em: Acronis Console → Management → API Clients → Create
ACRONIS_BASE_URL=https://eu2-cloud.acronis.com
ACRONIS_CLIENT_ID=
ACRONIS_CLIENT_SECRET=

# ===== Grafana =====
GRAFANA_URL=http://localhost:3000
GRAFANA_API_KEY=

# ===== LDAP / AD =====
LDAP_SERVER=ldap://dc.exemplo.local
LDAP_BIND_DN=CN=svc_dashboard,OU=Service,DC=exemplo,DC=local
LDAP_BIND_PASSWORD=
LDAP_BASE_DN=DC=exemplo,DC=local

# ===== Cache / Refresh =====
REFRESH_INTERVAL_SECONDS=300
CACHE_TTL_SECONDS=600

# ===== Logging =====
LOG_LEVEL=INFO
LOG_FILE=logs/dashboard.log

# ─────────────────────────────────────────────────────
# Diagnóstico Zabbix (scripts/diag_zbx.py)
# ─────────────────────────────────────────────────────
# Validação de certificado TLS (padrão: true)
ZBX_VERIFY_TLS=true
# Caminho opcional para CA bundle customizado
# ZBX_CA_BUNDLE=/etc/ssl/certs/internal-ca.pem
# Timeout em segundos para requisições à API
ZBX_TIMEOUT=10
