# ============================================
# IT Gov Dashboard — Template de Variáveis
# Copie para .env e preencha os valores reais
# NUNCA commite o .env real!
# ============================================

# ===== Flask =====
FLASK_ENV=production
FLASK_DEBUG=0
SECRET_KEY=change-me-use-secrets-token-hex-32

# ===== Zabbix =====
ZABBIX_URL=https://zabbix.exemplo.com/api_jsonrpc.php
ZABBIX_USER=api_user
ZABBIX_PASSWORD=
ZABBIX_TOKEN=

# ===== InfluxDB 2.x =====
INFLUX_URL=http://localhost:8086
INFLUX_TOKEN=
INFLUX_ORG=gadens
INFLUX_BUCKET=governance

# ===== Microsoft Graph (M365) =====
MSAL_TENANT_ID=
MSAL_CLIENT_ID=
MSAL_CLIENT_SECRET=

# ===== Grafana =====
GRAFANA_URL=http://localhost:3000
GRAFANA_API_KEY=

# ===== LDAP / AD =====
LDAP_SERVER=ldap://dc.exemplo.local
LDAP_BIND_DN=CN=svc_dashboard,OU=Service,DC=exemplo,DC=local
LDAP_BIND_PASSWORD=
LDAP_BASE_DN=DC=exemplo,DC=local

# ===== Cache / Refresh =====
REFRESH_INTERVAL_SECONDS=300
CACHE_TTL_SECONDS=600

# ===== Logging =====
LOG_LEVEL=INFO
LOG_FILE=logs/dashboard.log

# ─────────────────────────────────────────────────────
# Diagnóstico Zabbix (scripts/diag_zbx.py)
# ─────────────────────────────────────────────────────
# Validação de certificado TLS (padrão: true)
ZBX_VERIFY_TLS=true
# Caminho opcional para CA bundle customizado
# ZBX_CA_BUNDLE=/etc/ssl/certs/internal-ca.pem
# Timeout em segundos para requisições à API
ZBX_TIMEOUT=10
