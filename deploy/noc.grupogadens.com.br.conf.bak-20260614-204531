# ─────────────────────────────────────────────────────────────────────────────
# SERVIDOR HTTP (Porta 80) - ACME + redirect HTTPS [FIX AUTOMÁTICO]
# ─────────────────────────────────────────────────────────────────────────────
server {
    listen 80;
    listen [::]:80;
    server_name noc.grupogadens.com.br;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        auth_basic off;
        allow all;
        default_type "text/plain";
        allow all;
        try_files $uri =404;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}
