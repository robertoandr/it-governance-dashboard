# ============================================
# IT Governance Dashboard - .gitignore
# ============================================

# ===== Python =====
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
*.egg
dist/
build/
develop-eggs/
eggs/
.eggs/
wheels/
pip-wheel-metadata/
share/python-wheels/
MANIFEST

# ===== Virtual Environments =====
venv/
env/
ENV/
.venv/
.env/
virtualenv/

# ===== Ambiente / Secrets =====
.env
.env.local
.env.*.local
.env.bak*
.env.production
.env.staging
*.bak
*.bak.*
*.pre-*
!.pre-commit-config.yaml
*.orig
secrets/
credentials/

# TLS certs & private keys (never commit)
*.pem
*.key
*.crt
*.p12
*.pfx
nginx/certs/
*.pem
*.key
*.crt
!*.example

# ===== Testes / Coverage =====
.coverage
.coverage.*
htmlcov/
.pytest_cache/
.tox/
.nox/
coverage.xml
*.cover
.hypothesis/
nosetests.xml
junit.xml
test-results/

# ===== Lint / Type Check / Security =====
.ruff_cache/
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/
bandit-report.json
safety-report.json
.bandit

# ===== Dados / Backups / Logs =====
data/
!data/schema.sql
!data/seed.py
# app/data/license_costs.seed.json é o seed versionado consumido por
# ensure_costs_file() (itgov/api/v1/m365_licenses.py) — distinto do
# app/data/license_costs.json mutável (saída local, ver regra abaixo).
!app/data/
!app/data/license_costs.seed.json
_backups/
backups/
*.db
*.sqlite
*.sqlite3
*.log
logs/
*.dump
*.sql.gz

# ===== IDEs =====
.vscode/
!.vscode/settings.json.example
.idea/
*.swp
*.swo
*~
.project
.pydevproject
.spyderproject
.spyproject
.ropeproject

# ===== OS =====
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ===== Jupyter =====
.ipynb_checkpoints
*.ipynb

# ===== Node (se houver frontend assets) =====
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json

# ===== Docker =====
*.pid
docker-compose.override.yml

# ===== Projeto específico =====
instance/
*.local.py
local_settings.py

# Saídas locais de coletores (não versionar)
license_costs.json
*.local.json
zabbix-mcp-server/

# Logs
*.log
logs/

# Grafana provisioning — nunca commitar variações de backup
grafana/provisioning/**/*.bak
grafana/provisioning/**/*.old
grafana/provisioning/**/*.tmp
grafana/provisioning/**/*.orig
grafana/provisioning/**/*.disabled
CLAUDE.md.bkp-*
.env.backup*
smtp.env
fix-ldap-pass.sh
