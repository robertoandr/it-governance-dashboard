.env
.env.local
.env.*.local
.env.bak*
.env.production
.env.staging
*.bak
*.bak.*
*.pre-*
!.pre-commit-config.yaml
*.orig
secrets/
credentials/
*.pem
*.key
*.crt
!*.example

# ===== Testes / Coverage =====
.coverage
.coverage.*
htmlcov/
.pytest_cache/
.tox/
.nox/
coverage.xml
*.cover
.hypothesis/
nosetests.xml
junit.xml
test-results/

