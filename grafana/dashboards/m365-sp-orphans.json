{
  "__inputs": [
    {
      "name": "DS_INFLUXDB_M365",
      "label": "InfluxDB m365_security",
      "description": "InfluxDB v2 datasource (Flux)",
      "type": "datasource",
      "pluginId": "influxdb",
      "pluginName": "InfluxDB"
    }
  ],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "8.0.0" },
    { "type": "datasource", "id": "influxdb", "name": "InfluxDB", "version": "1.0.0" },
    { "type": "panel", "id": "stat", "name": "Stat", "version": "" },
    { "type": "panel", "id": "gauge", "name": "Gauge", "version": "" },
    { "type": "panel", "id": "timeseries", "name": "Time series", "version": "" },
    { "type": "panel", "id": "barchart", "name": "Bar chart", "version": "" },
    { "type": "panel", "id": "table", "name": "Table", "version": "" },
    { "type": "panel", "id": "piechart", "name": "Pie chart", "version": "" }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": "-- Grafana --",
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "Microsoft 365 Service Principals — Orphan & Risk Monitoring (Sprint 12)",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "id": 1,
      "title": "Total Service Principals",
      "type": "stat",
      "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB_M365}" },
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
      "options": {
        "reduceOptions": { "values": false, "calcs": ["lastNotNull"], "fields": "" },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "blue" }
            ]
          },
          "unit": "short",
          "mappings": []
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB_M365}" },
          "query": "from(bucket: \"m365_security\")\n  |> range(start: -1h)\n  |> filter(fn: (r) => r._measurement == \"sp_summary_snapshot\" and r._field == \"total_sps\")\n  |> filter(fn: (r) => r.tenant_id == \"${tenant}\")\n  |> last()\n  |> yield(name: \"total_sps\")"
        }
      ]
    },
    {
      "id": 2,
      "title": "% SPs em Risco",
      "type": "gauge",
      "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB_M365}" },
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 4 },
      "options": {
        "reduceOptions": { "values": false, "calcs": ["lastNotNull"], "fields": "" },
        "orientation": "auto",
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "green" },
              { "value": 25, "color": "yellow" },
              { "value": 50, "color": "red" }
            ]
          },
          "unit": "percent",
          "min": 0,
          "max": 100,
          "mappings": []
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB_M365}" },
          "query": "critical = from(bucket: \"m365_security\")\n  |> range(start: -1h)\n  |> filter(fn: (r) => r._measurement == \"sp_summary_snapshot\" and r._field == \"critical_count\")\n  |> filter(fn: (r) => r.tenant_id == \"${tenant}\")\n  |> last()\n\nhigh = from(bucket: \"m365_security\")\n  |> range(start: -1h)\n  |> filter(fn: (r) => r._measurement == \"sp_summary_snapshot\" and r._field == \"high_count\")\n  |> filter(fn: (r) => r.tenant_id == \"${tenant}\")\n  |> last()\n\nmedium = from(bucket: \"m365_security\")\n  |> range(start: -1h)\n  |> filter(fn: (r) => r._measurement == \"sp_summary_snapshot\" and r._field == \"medium_count\")\n  |> filter(fn: (r) => r.tenant_id == \"${tenant}\")\n  |> last()\n\ntotal = from(bucket: \"m365_security\")\n  |> range(start: -1h)\n  |> filter(fn: (r) => r._measurement == \"sp_summary_snapshot\" and r._field == \"total_sps\")\n  |> filter(fn: (r) => r.tenant_id == \"${tenant}\")\n  |> last()\n\nunion(tables: [critical, high, medium, total])\n  |> pivot(rowKey: [\"_time\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> map(fn: (r) => ({ r with _value: if r.total_sps > 0 then (float(v: r.critical_count + r.high_count + r.medium_count) / float(v: r.total_sps)) * 100.0 else 0.0 }))\n  |> keep(columns: [\"_time\", \"_value\"])\n  |> yield(name: \"pct_at_risk\")"
        }
      ]
    },
    {
      "id": 3,
      "title": "SPs CRITICAL",
      "type": "stat",
      "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB_M365}" },
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 4 },
      "options": {
        "reduceOptions": { "values": false, "calcs": ["lastNotNull"], "fields": "" },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "green" },
              { "value": 1, "color": "red" }
            ]
          },
          "unit": "short",
          "mappings": []
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB_M365}" },
          "query": "from(bucket: \"m365_security\")\n  |> range(start: -1h)\n  |> filter(fn: (r) => r._measurement == \"sp_summary_snapshot\" and r._field == \"critical_count\")\n  |> filter(fn: (r) => r.tenant_id == \"${tenant}\")\n  |> last()\n  |> yield(name: \"critical_count\")"
        }
      ]
    },
    {
      "id": 4,
      "title": "Avg Risk Score (últimos 7d)",
      "type": "stat",
      "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB_M365}" },
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 4 },
      "options": {
        "reduceOptions": { "values": false, "calcs": ["lastNotNull"], "fields": "" },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "green" },
              { "value": 26, "color": "yellow" },
              { "value": 51, "color": "orange" },
              { "value": 76, "color": "red" }
            ]
          },
          "unit": "short",
          "min": 0,
          "max": 100,
          "mappings": []
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB_M365}" },
          "query": "from(bucket: \"m365_security\")\n  |> range(start: -7d)\n  |> filter(fn: (r) => r._measurement == \"sp_summary_snapshot\" and r._field == \"avg_risk_score\")\n  |> filter(fn: (r) => r.tenant_id == \"${tenant}\")\n  |> last()\n  |> yield(name: \"avg_risk_score\")"
        }
      ]
    },
    {
      "id": 5,
      "title": "Evolução Risk Score Médio — 7 dias",
      "type": "timeseries",
      "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB_M365}" },
      "gridPos": { "x": 0, "y": 4, "w": 14, "h": 8 },
      "options": {
        "tooltip": { "mode": "multi", "sort": "none" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "gradientMode": "none",
            "spanNulls": false,
            "showPoints": "auto",
            "pointSize": 5
          },
          "unit": "short",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "green" },
              { "value": 26, "color": "yellow" },
              { "value": 51, "color": "orange" },
              { "value": 76, "color": "red" }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB_M365}" },
          "query": "from(bucket: \"m365_security\")\n  |> range(start: -7d)\n  |> filter(fn: (r) => r._measurement == \"service_principal_risk\" and r._field == \"risk_score\")\n  |> filter(fn: (r) => r.tenant_id == \"${tenant}\")\n  |> aggregateWindow(every: 1d, fn: mean, createEmpty: false)\n  |> yield(name: \"avg_risk_7d\")"
        }
      ]
    },
    {
      "id": 6,
      "title": "Distribuição por Risk Level",
      "type": "barchart",
      "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB_M365}" },
      "gridPos": { "x": 14, "y": 4, "w": 10, "h": 8 },
      "options": {
        "orientation": "auto",
        "xTickLabelRotation": 0,
        "xTickLabelSpacing": 100,
        "fillOpacity": 80,
        "gradientMode": "none",
        "tooltip": { "mode": "single", "sort": "none" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "blue" },
          "custom": { "lineWidth": 1, "fillOpacity": 80 },
          "unit": "short",
          "mappings": []
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "OK" },     "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }] },
          { "matcher": { "id": "byName", "options": "MEDIUM" },  "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "yellow" } }] },
          { "matcher": { "id": "byName", "options": "HIGH" },    "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } }] },
          { "matcher": { "id": "byName", "options": "CRITICAL" },"properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }] }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB_M365}" },
          "query": "from(bucket: \"m365_security\")\n  |> range(start: -1h)\n  |> filter(fn: (r) => r._measurement == \"service_principal_risk\" and r._field == \"risk_score\")\n  |> filter(fn: (r) => r.tenant_id == \"${tenant}\")\n  |> group(columns: [\"risk_level\"])\n  |> count()\n  |> rename(columns: {_value: \"count\"})\n  |> yield(name: \"distribution\")"
        }
      ]
    },
    {
      "id": 7,
      "title": "Top 20 SPs — Maior Risk Score",
      "type": "table",
      "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB_M365}" },
      "gridPos": { "x": 0, "y": 12, "w": 16, "h": 10 },
      "options": {
        "showHeader": true,
        "footer": { "show": false, "reducer": ["sum"], "fields": "" },
        "sortBy": [{ "displayName": "risk_score", "desc": true }]
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "custom": {
            "align": "auto",
            "displayMode": "auto",
            "filterable": true
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "green" },
              { "value": 26, "color": "yellow" },
              { "value": 51, "color": "orange" },
              { "value": 76, "color": "red" }
            ]
          },
          "mappings": []
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "risk_score" },
            "properties": [
              { "id": "custom.displayMode", "value": "color-background" },
              { "id": "custom.width", "value": 90 }
            ]
          },
          { "matcher": { "id": "byName", "options": "sp_object_id" },       "properties": [{ "id": "custom.width", "value": 280 }] },
          { "matcher": { "id": "byName", "options": "risk_level" },          "properties": [{ "id": "custom.width", "value": 90 }] },
          { "matcher": { "id": "byName", "options": "days_since_sign_in" },  "properties": [{ "id": "custom.width", "value": 120 }] },
          { "matcher": { "id": "byName", "options": "dangerous_perm_count" },"properties": [{ "id": "custom.width", "value": 130 }] },
          { "matcher": { "id": "byName", "options": "has_expired_creds" },   "properties": [{ "id": "custom.width", "value": 120 }] }
        ]
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": { "_start": true, "_stop": true, "_measurement": true, "tenant_id": true, "sp_type": true, "result": true, "table": true },
            "indexByName": {
              "sp_object_id": 0,
              "risk_score": 1,
              "risk_level": 2,
              "days_since_sign_in": 3,
              "dangerous_perm_count": 4,
              "has_expired_creds": 5
            },
            "renameByName": {
              "sp_object_id": "Object ID",
              "risk_score": "Score",
              "risk_level": "Level",
              "days_since_sign_in": "Days Since Login",
              "dangerous_perm_count": "Dangerous Perms",
              "has_expired_creds": "Expired Creds"
            }
          }
        }
      ],
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB_M365}" },
          "query": "from(bucket: \"m365_security\")\n  |> range(start: -1h)\n  |> filter(fn: (r) => r._measurement == \"service_principal_risk\")\n  |> filter(fn: (r) => r.tenant_id == \"${tenant}\")\n  |> filter(fn: (r) => r._field == \"risk_score\" or r._field == \"days_since_sign_in\" or r._field == \"dangerous_perm_count\" or r._field == \"has_expired_creds\" or r._field == \"sp_object_id\")\n  |> last()\n  |> pivot(rowKey: [\"_time\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> top(n: 20, columns: [\"risk_score\"])\n  |> yield(name: \"top20\")"
        }
      ]
    },
    {
      "id": 8,
      "title": "Status de Credenciais",
      "type": "piechart",
      "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB_M365}" },
      "gridPos": { "x": 16, "y": 12, "w": 8, "h": 10 },
      "options": {
        "reduceOptions": { "values": false, "calcs": ["lastNotNull"], "fields": "" },
        "pieType": "donut",
        "tooltip": { "mode": "single", "sort": "none" },
        "legend": { "displayMode": "table", "placement": "right", "values": ["value", "percent"] }
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "mappings": [],
          "unit": "short"
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "Expiradas" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }] },
          { "matcher": { "id": "byName", "options": "Válidas" },   "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }] }
        ]
      },
      "targets": [
        {
          "refId": "Expiradas",
          "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB_M365}" },
          "query": "from(bucket: \"m365_security\")\n  |> range(start: -1h)\n  |> filter(fn: (r) => r._measurement == \"service_principal_risk\" and r._field == \"has_expired_creds\")\n  |> filter(fn: (r) => r.tenant_id == \"${tenant}\")\n  |> filter(fn: (r) => r._value == true)\n  |> count()\n  |> set(key: \"_field\", value: \"Expiradas\")\n  |> yield(name: \"expired_true\")"
        },
        {
          "refId": "Válidas",
          "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB_M365}" },
          "query": "from(bucket: \"m365_security\")\n  |> range(start: -1h)\n  |> filter(fn: (r) => r._measurement == \"service_principal_risk\" and r._field == \"has_expired_creds\")\n  |> filter(fn: (r) => r.tenant_id == \"${tenant}\")\n  |> filter(fn: (r) => r._value == false)\n  |> count()\n  |> set(key: \"_field\", value: \"Válidas\")\n  |> yield(name: \"expired_false\")"
        }
      ]
    }
  ],
  "refresh": "5m",
  "schemaVersion": 36,
  "style": "dark",
  "tags": ["m365", "security", "sprint-12", "service-principals"],
  "templating": {
    "list": [
      {
        "current": {},
        "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB_M365}" },
        "definition": "from(bucket: \"m365_security\") |> range(start: -1h) |> filter(fn: (r) => r._measurement == \"sp_summary_snapshot\") |> group(columns: [\"tenant_id\"]) |> distinct(column: \"tenant_id\") |> keep(columns: [\"_value\"])",
        "hide": 0,
        "includeAll": false,
        "multi": false,
        "name": "tenant",
        "options": [],
        "query": "from(bucket: \"m365_security\") |> range(start: -1h) |> filter(fn: (r) => r._measurement == \"sp_summary_snapshot\") |> group(columns: [\"tenant_id\"]) |> distinct(column: \"tenant_id\") |> keep(columns: [\"_value\"])",
        "refresh": 2,
        "type": "query",
        "label": "Tenant"
      },
      {
        "current": { "selected": true, "text": "ALL", "value": "ALL" },
        "hide": 0,
        "includeAll": true,
        "multi": false,
        "name": "risk_level",
        "options": [
          { "selected": true, "text": "ALL",      "value": "ALL" },
          { "selected": false, "text": "OK",       "value": "OK" },
          { "selected": false, "text": "MEDIUM",   "value": "MEDIUM" },
          { "selected": false, "text": "HIGH",     "value": "HIGH" },
          { "selected": false, "text": "CRITICAL", "value": "CRITICAL" }
        ],
        "query": "ALL,OK,MEDIUM,HIGH,CRITICAL",
        "type": "custom",
        "label": "Risk Level"
      },
      {
        "auto": false,
        "current": { "selected": true, "text": "1h", "value": "1h" },
        "hide": 0,
        "name": "time_range",
        "options": [
          { "selected": true,  "text": "1h",  "value": "1h" },
          { "selected": false, "text": "6h",  "value": "6h" },
          { "selected": false, "text": "24h", "value": "24h" },
          { "selected": false, "text": "7d",  "value": "7d" },
          { "selected": false, "text": "30d", "value": "30d" }
        ],
        "query": "1h,6h,24h,7d,30d",
        "type": "custom",
        "label": "Time Range"
      }
    ]
  },
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "M365 — Service Principals Orphan Risk",
  "uid": "m365-sp-orphans-v1",
  "version": 1
}
