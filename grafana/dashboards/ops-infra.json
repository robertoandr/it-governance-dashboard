{
  "uid": "ops-infra-001",
  "title": "Ops & Infra",
  "description": "Infraestrutura e alertas operacionais via Zabbix — gov_zabbix_problem e gov_zabbix_summary",
  "tags": ["governance", "ops", "infra", "zabbix"],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5m",
  "time": { "from": "now-7d", "to": "now" },
  "timepicker": {},
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "",
      "gridPos": { "h": 2, "w": 24, "x": 0, "y": 0 },
      "options": {
        "mode": "markdown",
        "content": "## 🖥️ Ops & Infra — Alertas Zabbix\nMonitoramento de infraestrutura: CFTV, DVRs, Microsoft 365. Dados coletados a cada 5 minutos."
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Desastres Ativos",
      "description": "Alertas de nível Disaster no Zabbix agora. Qualquer valor > 0 requer atenção imediata.",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 2 },
      "datasource": { "type": "influxdb", "uid": "InfluxDB-Governanca" },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "auto",
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "influxdb", "uid": "InfluxDB-Governanca" },
          "query": "from(bucket: \"governance_raw\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"gov_zabbix_summary\" and r.available == \"true\")\n  |> filter(fn: (r) => r._field == \"problems_disaster\")\n  |> last()"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Alertas High",
      "description": "Alertas de nível High no Zabbix. Requerem atenção no próximo turno.",
