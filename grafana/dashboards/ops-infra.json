              { "color": "green", "value": null },
              { "color": "orange", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "influxdb", "uid": "InfluxDB-Governanca" },
          "query": "from(bucket: \"governance_raw\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"gov_zabbix_summary\" and r.available == \"true\")\n  |> filter(fn: (r) => r._field == \"problems_high\")\n  |> last()"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Total de Alertas",
      "description": "Total de alertas ativos no Zabbix (todas as severidades).",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 2 },
      "datasource": { "type": "influxdb", "uid": "InfluxDB-Governanca" },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "auto",
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 5 },
              { "color": "orange", "value": 15 },
              { "color": "red", "value": 30 }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "influxdb", "uid": "InfluxDB-Governanca" },
          "query": "from(bucket: \"governance_raw\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"gov_zabbix_summary\" and r.available == \"true\")\n  |> filter(fn: (r) => r._field == \"problems_total\")\n  |> last()"
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Zabbix Disponível",
      "description": "Indica se a coleta Zabbix está funcionando. false = coletor não conseguiu alcançar a API.",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 2 },
      "datasource": { "type": "influxdb", "uid": "InfluxDB-Governanca" },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "auto",
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null }
            ]
          },
          "mappings": [
            { "type": "value", "options": { "true": { "text": "OK", "color": "green" }, "false": { "text": "OFFLINE", "color": "red" } } }
          ]
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "influxdb", "uid": "InfluxDB-Governanca" },
          "query": "from(bucket: \"governance_raw\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"gov_zabbix_summary\")\n  |> filter(fn: (r) => r._field == \"problems_total\")\n  |> last()\n  |> map(fn: (r) => ({r with _value: r.available}))"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Histórico de Alertas por Severidade (7d)",
      "description": "Evolução dos alertas ativos por severidade ao longo do tempo.",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 6 },
      "datasource": { "type": "influxdb", "uid": "InfluxDB-Governanca" },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 15,
            "spanNulls": false,
            "showPoints": "never"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "green", "value": null }]
          },
          "color": { "mode": "palette-classic" }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "disaster" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }] },
          { "matcher": { "id": "byName", "options": "high" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } }] },
          { "matcher": { "id": "byName", "options": "average" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "yellow" } }] },
          { "matcher": { "id": "byName", "options": "warning" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "blue" } }] }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "influxdb", "uid": "InfluxDB-Governanca" },
          "query": "from(bucket: \"governance_raw\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"gov_zabbix_problem\" and r.available == \"true\")\n  |> filter(fn: (r) => r._field == \"count\")\n  |> group(columns: [\"severity\"])\n  |> aggregateWindow(every: 1h, fn: last, createEmpty: false)\n  |> map(fn: (r) => ({r with _field: r.severity}))"
        }
      ]
    },
