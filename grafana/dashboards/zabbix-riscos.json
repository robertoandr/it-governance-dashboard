  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "",
      "gridPos": { "h": 2, "w": 24, "x": 0, "y": 0 },
      "options": {
        "mode": "markdown",
        "content": "## Gestão de Riscos — Infraestrutura Zabbix\nScore calculado por decaimento multiplicativo sobre alertas ativos. Atualizado a cada hora. Fonte: `gov_zabbix_riscos`."
      }
    },
    {
      "id": 2,
      "type": "gauge",
      "title": "Score de Riscos",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 2 },
      "datasource": { "type": "influxdb", "uid": "InfluxDB-Governanca" },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"governance_raw\")\n  |> range(start: -2h)\n  |> filter(fn: (r) => r._measurement == \"gov_zabbix_riscos\")\n  |> filter(fn: (r) => r._field == \"score\")\n  |> last()"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "showThresholdLabels": false,
        "showThresholdMarkers": true,
        "orientation": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 100,
          "unit": "none",
          "decimals": 1,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red",    "value": null },
              { "color": "yellow", "value": 40 },
              { "color": "green",  "value": 70 }
            ]
          }
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Incidentes Críticos (Disaster + High)",
