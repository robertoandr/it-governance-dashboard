      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"governance_raw\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"gov_acronis_agents\")\n  |> filter(fn: (r) => r._field == \"total\")\n  |> last()"
