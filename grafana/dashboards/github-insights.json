  "templating": {
    "list": [
      {
        "name": "repo",
        "type": "query",
        "label": "Repositório",
        "datasource": {
          "type": "influxdb",
          "uid": "InfluxDB-Governanca"
        },
        "query": "import \"influxdata/influxdb/schema\"\nschema.tagValues(bucket: \"governance_raw\", tag: \"repo\", predicate: (r) => r._measurement == \"gov_github_pr\")",
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "refresh": 2,
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "type": "stat",
      "title": "Total PRs",
      "id": 1,
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "influxdb",
        "uid": "InfluxDB-Governanca"
      },
      "targets": [
        {
          "query": "from(bucket: \"governance_raw\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"gov_github_pr\")\n  |> filter(fn: (r) => r._field == \"count\")\n  |> filter(fn: (r) => r.repo =~ /^${repo:regex}$/)\n  |> sum()",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "sum"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "fixedColor": "blue",
            "mode": "fixed"
          },
          "unit": "short"
        }
      }
    },
