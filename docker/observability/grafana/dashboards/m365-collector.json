{
  "id": null,
  "uid": "itgov-m365-collector",
  "title": "M365 Collector Health",
  "description": "RED metrics and governance KPIs for the M365 SP Orphans Collector.",
  "tags": ["itgov", "m365", "observability"],
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-3h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "tenant",
        "label": "Tenant",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": "label_values(itgov_m365_collections_total, tenant)",
        "multi": true,
        "includeAll": true,
        "current": { "text": "All", "value": "$__all" },
        "refresh": 2
      },
      {
        "name": "interval",
        "label": "Interval",
        "type": "interval",
        "options": [
          { "text": "1m",  "value": "1m"  },
          { "text": "5m",  "value": "5m"  },
          { "text": "10m", "value": "10m" },
          { "text": "30m", "value": "30m" }
        ],
        "current": { "text": "5m", "value": "5m" },
        "auto": true,
        "auto_min": "30s"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Operations (RED)",
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 1 },
      "collapsed": false
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Collections / min",
      "gridPos": { "x": 0, "y": 1, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(rate(itgov_m365_collections_total{tenant=~\"$tenant\"}[$interval])) * 60",
          "legendFormat": "rate"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red",   "value": null },
              { "color": "yellow","value": 0.1  },
              { "color": "green", "value": 0.5  }
            ]
          }
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Error Rate",
      "gridPos": { "x": 4, "y": 1, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(rate(itgov_m365_collections_total{tenant=~\"$tenant\",status=\"error\"}[$interval])) / (sum(rate(itgov_m365_collections_total{tenant=~\"$tenant\"}[$interval])) + 0.001)",
          "legendFormat": "error%"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green",  "value": null },
              { "color": "yellow", "value": 0.05 },
              { "color": "red",    "value": 0.10 }
            ]
          }
        }
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Graph API p95",
      "gridPos": { "x": 8, "y": 1, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(itgov_m365_graph_request_duration_seconds_bucket{tenant=~\"$tenant\"}[$interval])) by (le))",
          "legendFormat": "p95"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "value",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green",  "value": null },
              { "color": "yellow", "value": 1.0  },
              { "color": "red",    "value": 2.0  }
            ]
          }
        }
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Total Graph Requests",
      "gridPos": { "x": 12, "y": 1, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(increase(itgov_m365_graph_requests_total{tenant=~\"$tenant\"}[1h]))",
          "legendFormat": "reqs/hr"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "value",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": { "unit": "short" }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Graph Requests / min",
      "gridPos": { "x": 0, "y": 5, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (tenant) (rate(itgov_m365_graph_requests_total{tenant=~\"$tenant\",status_code=\"200\"}[$interval])) * 60",
          "legendFormat": "{{tenant}} ok"
        },
        {
          "expr": "sum by (tenant) (rate(itgov_m365_graph_requests_total{tenant=~\"$tenant\",status_code!=\"200\"}[$interval])) * 60",
          "legendFormat": "{{tenant}} error"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "lineWidth": 2 } },
        "overrides": [
          {
            "matcher": { "id": "byRegexp", "options": ".*error" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }
            ]
          }
        ]
      },
      "options": { "tooltip": { "mode": "multi" } }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Error Rate by Type",
      "gridPos": { "x": 12, "y": 5, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (error_type) (rate(itgov_m365_graph_errors_total{tenant=~\"$tenant\"}[$interval]))",
          "legendFormat": "{{error_type}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "lineWidth": 2 } }
      },
      "options": { "tooltip": { "mode": "multi" } }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Collection Duration p50 / p95 / p99",
      "gridPos": { "x": 0, "y": 13, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(itgov_m365_collection_duration_seconds_bucket{tenant=~\"$tenant\"}[$interval])) by (le))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(itgov_m365_collection_duration_seconds_bucket{tenant=~\"$tenant\"}[$interval])) by (le))",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(itgov_m365_collection_duration_seconds_bucket{tenant=~\"$tenant\"}[$interval])) by (le))",
          "legendFormat": "p99"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s", "custom": { "lineWidth": 2 } }
      },
      "options": { "tooltip": { "mode": "multi" } }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Collections / min by Status",
      "gridPos": { "x": 12, "y": 13, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (tenant, status) (rate(itgov_m365_collections_total{tenant=~\"$tenant\"}[$interval])) * 60",
          "legendFormat": "{{tenant}} {{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "lineWidth": 2 } }
      },
      "options": { "tooltip": { "mode": "multi" } }
    },
    {
      "id": 10,
      "type": "row",
      "title": "Governance (Risk KPIs)",
      "gridPos": { "x": 0, "y": 21, "w": 24, "h": 1 },
      "collapsed": false
    },
    {
      "id": 11,
      "type": "stat",
      "title": "SPs Scanned (last collection)",
      "gridPos": { "x": 0, "y": 22, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(itgov_m365_sps_risk_count{tenant=~\"$tenant\"})",
          "legendFormat": "total"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "value",
        "textMode": "auto"
      },
      "fieldConfig": { "defaults": { "unit": "short" } }
    },
    {
      "id": 12,
      "type": "stat",
      "title": "Critical Risk SPs",
      "gridPos": { "x": 4, "y": 22, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(itgov_m365_sps_risk_count{tenant=~\"$tenant\",risk_level=\"critical\"})",
          "legendFormat": "critical"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green",  "value": null },
              { "color": "yellow", "value": 1    },
              { "color": "red",    "value": 5    }
            ]
          }
        }
      }
    },
    {
      "id": 13,
      "type": "stat",
      "title": "High Risk SPs",
      "gridPos": { "x": 8, "y": 22, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(itgov_m365_sps_risk_count{tenant=~\"$tenant\",risk_level=\"high\"})",
          "legendFormat": "high"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green",  "value": null },
              { "color": "yellow", "value": 3    },
              { "color": "red",    "value": 10   }
            ]
          }
        }
      }
    },
    {
      "id": 14,
      "type": "stat",
      "title": "Orphans Actionable (Crit+High)",
      "gridPos": { "x": 12, "y": 22, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(itgov_m365_sps_orphans_actionable{tenant=~\"$tenant\"})",
          "legendFormat": "actionable"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green",  "value": null },
              { "color": "yellow", "value": 1    },
              { "color": "red",    "value": 10   }
            ]
          }
        }
      }
    },
    {
      "id": 15,
      "type": "bargauge",
      "title": "Risk Distribution",
      "gridPos": { "x": 16, "y": 22, "w": 8, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (risk_level) (itgov_m365_sps_risk_count{tenant=~\"$tenant\"})",
          "legendFormat": "{{risk_level}}"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "horizontal",
        "displayMode": "gradient"
      },
      "fieldConfig": {
        "defaults": { "unit": "short" }
      }
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "Critical + High Risk Trend",
      "gridPos": { "x": 0, "y": 26, "w": 16, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (risk_level) (itgov_m365_sps_risk_count{tenant=~\"$tenant\",risk_level=~\"critical|high\"})",
          "legendFormat": "{{risk_level}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "lineWidth": 2, "fillOpacity": 10 } },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "critical" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "high" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } }
            ]
          }
        ]
      },
      "options": { "tooltip": { "mode": "multi" } }
    },
    {
      "id": 17,
      "type": "stat",
      "title": "Orphans Actionable by Tenant",
      "gridPos": { "x": 16, "y": 26, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "itgov_m365_sps_orphans_actionable{tenant=~\"$tenant\"}",
          "legendFormat": "{{tenant}}"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "vertical",
        "colorMode": "background",
        "textMode": "value_and_name"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green",  "value": null },
              { "color": "yellow", "value": 1    },
              { "color": "red",    "value": 10   }
            ]
          }
        }
      }
    }
  ]
}
