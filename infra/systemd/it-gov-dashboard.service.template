# Template — copiar para /etc/systemd/system/it-gov-dashboard.service
# Instalação: sudo bash infra/systemd/install.sh
#
# Postmortem ref: 2026-06-07 — crash loop silencioso detectado tarde demais
# Deprecação ref: dashboard-ti V1.0 deprecado em 2026-06-07 (664 restarts)

[Unit]
Description=IT Governance Dashboard V1.1
After=network-online.target
Wants=network-online.target
# Evita crash loop silencioso: falha se reiniciar >3x em 60s
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=notify
User={{ SERVICE_USER }}
Group={{ SERVICE_GROUP }}
WorkingDirectory={{ WORKDIR }}
EnvironmentFile={{ ENV_FILE }}
ExecStart={{ VENV_PATH }}/bin/gunicorn \
  -c {{ WORKDIR }}/deploy/gunicorn.conf.py \
  wsgi_prod:app

# Watchdog: se app travar sem crash, systemd detecta em 60s e reinicia
WatchdogSec=60

# Reinício automático com backoff
Restart=on-failure
RestartSec=5s

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths={{ WORKDIR }}/data {{ WORKDIR }}/run {{ LOG_DIR }}

# Limites de recursos
LimitNOFILE=4096
MemoryMax=512M
CPUQuota=50%

[Install]
WantedBy=multi-user.target
